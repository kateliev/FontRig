{
    "version": 2,
    "autoExecute": {
        "enabled": true,
        "trigger": "<!--EXECUTE-->",
        "selfCorrect": true,
        "maxIterations": 3
    },
    "providers": {
        "ollama": {
            "name": "Ollama (Local)",
            "type": "ollama",
